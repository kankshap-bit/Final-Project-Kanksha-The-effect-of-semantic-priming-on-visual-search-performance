        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="VISUAL SEARCH TASK&amp;#10;You will first see a word, followed by an array of six words.&amp;#10;Your task is to determine whether at least one FRUIT is present in the six-word array.&amp;#10;- Press Y if a fruit is present.&amp;#10;- Press N if no fruit is present.&amp;#10;Ignore the first word when making your decision.&amp;#10;Respond as quickly and accurately as possible.&amp;#10;First few trials are practise, you will be informed before main trials begin. &amp;#10;Press SPACE to begin.&amp;#10;" valType="str" updates="constant" name="text"/>
